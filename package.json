{
  "name": "otel-cost-exporter",
  "version": "0.1.0",
  "private": true,
  "description": "OpenTelemetry-native LLM cost metrics exporter with multi-provider pricing support",
  "type": "module",
  "scripts": {
    "build": "pnpm install && turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "validate-pricing": "tsx scripts/validate-pricing.ts",
    "generate-pricing": "tsx scripts/generate-pricing.ts",
    "pricing-diff": "tsx scripts/pricing-diff.ts"
  },
  "keywords": [
    "opentelemetry",
    "otel",
    "llm",
    "cost",
    "pricing",
    "openai",
    "anthropic",
    "metrics",
    "observability"
  ],
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "license": "MIT",
  "packageManager": "pnpm@10.22.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/otel-cost-exporter.git"
  },
  "bugs": {
    "url": "https://github.com/reaatech/otel-cost-exporter/issues"
  },
  "homepage": "https://github.com/reaatech/otel-cost-exporter#readme",
  "pnpm": {
    "overrides": {
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "protobufjs": ">=8.6.0",
      "@grpc/grpc-js": ">=1.14.4",
      "esbuild": ">=0.28.1",
      "@opentelemetry/core": ">=2.8.0",
      "js-yaml": ">=4.2.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.28.1",
    "@vitest/coverage-v8": "^4.1.0",
    "tsx": "^4.23.0",
    "turbo": "^2.10.4",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.0",
    "yaml": "^2.6.1"
  }
}
