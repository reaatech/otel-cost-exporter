{
  "name": "@reaatech/otel-cost-exporter-pricing",
  "version": "0.1.0",
  "description": "LLM pricing table management with bundled provider pricing data",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/otel-cost-exporter.git",
    "directory": "packages/pricing"
  },
  "homepage": "https://github.com/reaatech/otel-cost-exporter/tree/main/packages/pricing#readme",
  "bugs": {
    "url": "https://github.com/reaatech/otel-cost-exporter/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "pricing-tables"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@reaatech/otel-cost-exporter-core": "workspace:*",
    "yaml": "^2.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  }
}
