# otel-cost-exporter environment variables
# Copy to .env and fill in values

# Pricing configuration
# OTEL_COST_PRICING_CUSTOM_TABLE_PATH=/etc/otel/pricing.yaml
# OTEL_COST_PRICING_AUTO_UPDATE=true
# OTEL_COST_PRICING_UPDATE_INTERVAL=24h
# OTEL_COST_PRICING_UPDATE_URL=https://github.com/reaatech/otel-cost-exporter/releases/latest/download/pricing-tables.tar.gz
#   NOTE: Remote pricing auto-update is not yet implemented (targeted for Phase 3).
#   Currently, pricing tables are bundled with the package and updated via npm releases.
# OTEL_COST_PRICING_DEFAULT_PRICE=2.0

# Metrics configuration
# OTEL_COST_METRICS_PREFIX=llm_cost
# OTEL_COST_METRICS_LABELS={"environment":"production","team":"platform"}

# Export configuration
# OTEL_COST_EXPORT_FORMAT=prometheus
# OTEL_COST_EXPORT_INTERVAL=60s
# OTEL_COST_EXPORT_ENDPOINT=http://localhost:9090

# Logging
# OTEL_COST_LOG_LEVEL=info
# OTEL_COST_LOG_FORMAT=json
