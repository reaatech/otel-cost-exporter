{
  "name": "otel-cost-exporter",
  "version": "0.1.0",
  "description": "OpenTelemetry-native exporter that converts LLM span data into cost metrics automatically with bundled pricing tables for every major provider",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "otel-cost-exporter": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./collector": {
      "types": "./dist/collector/index.d.ts",
      "import": "./dist/collector/index.js"
    },
    "./pricing": {
      "types": "./dist/pricing/index.d.ts",
      "import": "./dist/pricing/index.js"
    }
  },
  "files": [
    "dist",
    "pricing-tables",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "pre-commit": "pnpm typecheck && pnpm lint && pnpm test:coverage",
    "validate-pricing": "tsx scripts/validate-pricing.ts",
    "generate-pricing": "tsx scripts/generate-pricing.ts",
    "pricing-diff": "tsx scripts/pricing-diff.ts",
    "bump-patch": "npm version patch --no-git-tag-version",
    "security-scan": "pnpm audit --audit-level=high",
    "security-lint": "eslint src tests --rule 'no-eval: error'"
  },
  "keywords": [
    "opentelemetry",
    "otel",
    "llm",
    "cost",
    "telemetry",
    "genai",
    "prometheus",
    "openai",
    "anthropic",
    "google",
    "aws-bedrock",
    "azure-openai",
    "token-usage",
    "cost-monitoring",
    "finops"
  ],
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.52.0",
    "@opentelemetry/exporter-prometheus": "^0.52.0",
    "@opentelemetry/resources": "^1.26.0",
    "@opentelemetry/sdk-metrics": "^1.26.0",
    "@opentelemetry/sdk-node": "^0.53.0",
    "@opentelemetry/sdk-trace-base": "^1.26.0",
    "@opentelemetry/sdk-trace-node": "^1.26.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "commander": "^12.1.0",
    "pino": "^9.4.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "pino-pretty": "^11.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.8.0",
    "vite": "^6",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/otel-cost-exporter.git"
  },
  "bugs": {
    "url": "https://github.com/reaatech/otel-cost-exporter/issues"
  },
  "homepage": "https://github.com/reaatech/otel-cost-exporter#readme"
}
